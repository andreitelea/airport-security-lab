<!--
  Monteverde Airport - Chapter 8
  Group appended to /var/ossec/etc/rules/local_rules.xml (wazuh-srv)

  100100 - one packet blocked by the host firewall (ufw): low severity,
           a single blocked packet is normal background noise.
  100101 - correlation: 10 blocked packets from the same source IP
           within 60 seconds -> possible port scan, high severity.

  Note: with "logging low", ufw rate-limits its own log entries, so Wazuh
  sees a sample of the blocked packets, not every one.
-->
<group name="ufw,firewall,">

  <rule id="100100" level="5">
    <decoded_as>kernel</decoded_as>
    <match>UFW BLOCK</match>
    <description>UFW: inbound packet blocked by host firewall</description>
    <group>firewall_drop,</group>
  </rule>

  <rule id="100101" level="10" frequency="10" timeframe="60">
    <if_matched_sid>100100</if_matched_sid>
    <same_source_ip />
    <description>UFW: possible port scan - many blocks from same source</description>
    <group>recon,attack,</group>
  </rule>

</group>
